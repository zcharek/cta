{
  "include": [
    "client/src/**/*",
    "client/cockpit/**/*",
    "api/**/*",
    "shared/**/*",
    "tests/**/*",
    "scripts/**/*.d.mts",
    "vitest.config.ts"
  ],
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "target": "ES2020",
    "strict": true,
    "lib": [
      "esnext",
      "dom",
      "dom.iterable"
    ],
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "@/*": [
        "./client/src/*"
      ]
    }
  }
}
