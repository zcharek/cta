# Copiez ce fichier en .env (jamais commité) et remplissez les valeurs.
# En production, saisissez les mêmes variables dans Vercel > Project > Settings > Environment Variables.

# Base Postgres Neon (chaîne de connexion « pooled »)
DATABASE_URL=

# Secret de signature des sessions : 32 caractères minimum (ex. : openssl rand -base64 48)
AUTH_SECRET=

# Espace client : plus de variable ADMIN_EMAILS. Un admin est désigné par : npm run db:make-admin -- email@exemple.com

# --- Cockpit ---

# Adresse publique du site, sans / final. Sert à construire les liens des e-mails.
# Obligatoire en production (ex. : https://www.centraltestagency.com).
APP_URL=http://localhost:3000

# Resend : clé d'API et expéditeur (le domaine doit être vérifié chez Resend).
# Sans clé hors production, les e-mails ne partent pas : le lien est affiché à l'écran et dans la console.
RESEND_API_KEY=
EMAIL_FROM="Cockpit CTA <cockpit@centraltestagency.com>"
# Adresse qui reçoit les réponses aux e-mails (facultatif), par exemple une boîte Gmail.
EMAIL_REPLY_TO=

# Premier compte Co-Founder, créé par : npm run cockpit:seed
# Sans mot de passe, le script affiche un lien pour le définir.
COCKPIT_SEED_EMAIL=
COCKPIT_SEED_NOM=
COCKPIT_SEED_MOT_DE_PASSE=
